# Text is stored with LF. On Windows, Python's write_text/open("w") and
# pandas' to_csv write CRLF; this keeps regenerated outputs from showing as
# whole-file changes. The rules below override it for specific files.
* text=auto eol=lf

# Committed with CRLF as delivered; kept byte-exact.
research/notebook-outputs/nb1d/scanvi_pbmc240_lineage_per_seed.csv -text
research/notebook-outputs/nb1d/scanvi_pbmc240_lineage_recall_and_composition.csv -text
service/examples/pbmc240_proteins_raw.tsv -text
service/examples/pbmc240_zscored_all_genes.csv -text
service/model/evidence/v3_1_tables/latent_centroid_cosine.csv -text
web/data/metadata_PROT_lat128.csv -text
web/data/metadata_RNA_lat128.csv -text

web/data/atlas_RNA_lat128.parquet filter=lfs diff=lfs merge=lfs -text
web/data/atlas_RNA_lat128-001-part1.csv filter=lfs diff=lfs merge=lfs -text
web/data/atlas_RNA_lat128-001-part2.csv filter=lfs diff=lfs merge=lfs -text

# ~94 MB, close enough to GitHub's 100 MB hard limit on a plain git object
# to track via LFS even though the repo's other non-RNA files under that
# threshold (e.g. the ~45 MB protein CSV) are not.
service/model/legacy/dev/H_seed4.pt filter=lfs diff=lfs merge=lfs -text

# Same reasoning, same size class (~94 MB) — the production v3 checkpoint.
service/model/runtime/reference_model.pt filter=lfs diff=lfs merge=lfs -text

# ~82 MB, the real raw SCoPE2 protein input (blood_joint_cells_by_proteins_
# GENELEVEL.tsv) that the export notebook actually used and this repo lost
# once before by never committing it (see research/benchmark/known-limitations.md).
# Close enough to the 100 MB limit, and too important to lose again, to
# track via LFS despite being below the ~94 MB class above.
service/model/source/app_export/blood_joint_cells_by_proteins_GENELEVEL.tsv filter=lfs diff=lfs merge=lfs -text

# Byte-exact on every platform: these files' sha256 is checked
# (service/model/v3_1/MANIFEST.json, runtime/gene_id_map_v1_provenance.json),
# so line-ending conversion (Windows core.autocrlf) must never touch them.
service/model/v3_1/** -text
service/model/runtime/** -text

# Scripts keep LF so they run under Git Bash and Rscript on Windows too.
*.sh text eol=lf
*.R text eol=lf

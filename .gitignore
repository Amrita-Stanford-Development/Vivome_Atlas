__pycache__/
*.py[cod]
.DS_Store
node_modules/

# Local staging for notebook deliveries (e.g. T1 NB1d's ~230 MB of per-seed
# embeddings) — inputs, not source. The small tables every reported number
# cites are copied to research/notebook-outputs/ and committed there. See
# data/README.md.
data/incoming/

# The v3.1 ensemble's five NB1b checkpoints (~98 MB each) live outside git:
# fetch them with scripts/fetch_v31_members.py, which checks each against
# service/model/v3_1/MANIFEST.json.
service/model/v3_1/members/*.pt
# v5's and v5.1's data stay outside git (~110 MB of latents per version, plus
# checkpoints): research/notebooks/v5_build.py rebuilds them from the members on
# the project Drive (Data/Results/Tier1_v31/V5/ckpt/ and ckpt_v51/). Their specs
# and MANIFEST.json, which hold every file's sha256, are tracked.
service/model/v5/members/
service/model/v5/*.npy
service/model/v5/*.npz
service/model/v5_1/members/
service/model/v5_1/*.npy
service/model/v5_1/*.npz
service/model/v5_2/members/
service/model/v5_2/*.npy
service/model/v5_2/*.npz
service/model/v5_3/members/
service/model/v5_3/*.npy
service/model/v5_3/*.npz
service/model/v5_4/members/
service/model/v5_4/*.npy
service/model/v5_4/*.npz

# Cloudflare Pages build output and wrangler cache (scripts/build_pages_site.py)
/dist/
.wrangler/

# The Hugging Face Space as staged for publishing (deploy/huggingface/build_space.py):
# copies of service/ and of the served version's model files.
/deploy/huggingface/space/

.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Journal figure files (PDF, 600 dpi TIFF): rebuilt on request by scripts/build_figures.py --journal
research/figures/journal/

# The film's HyperFrames project (motion/, docs/web/motion.md): the site code
# and data scripts/prepare.mjs copies and writes, Manim's frames, and
# HyperFrames' snapshots, state and renders. The stills it makes are
# committed under web/motion/frames/.
motion/vendor/
motion/build/
motion/.hyperframes/
motion/renders/
